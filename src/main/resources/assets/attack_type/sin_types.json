      "SLOTH":    { "r": 1.0, "g": 0.9, "b": 0.1, "name": "黄" },
      "GLUTTONY": { "r": 0.2, "g": 0.8, "b": 0.2, "name": "草绿" },
      "GLOOM":    { "r": 0.2, "g": 0.7, "b": 1.0, "name": "天蓝" },
      "PRIDE":    { "r": 0.1, "g": 0.2, "b": 0.8, "name": "深蓝" },
      "ENVY":     { "r": 0.6, "g": 0.2, "b": 1.0, "name": "紫" }
    }
  },

  "qolFeatures": {
    "_comment": "QoL 特性开关",
    "alwaysEat": { "enabled": true, "source": "MixinPlayerEntity.canConsume()", "description": "满饱食度也可进食" },
    "alwaysSleep": { "enabled": true, "source": "MixinServerPlayerEntity.trySleep()", "description": "白天也可睡觉，可反复睡" }
  },

  "damageFormula": {
    "_comment": "伤害计算公式（与 MixinLivingEntity.java 一致）",
    "formula": "applyDamage(amount × physMult) + sinDamage",
    "physMult": "physicalResistance × Π(1 - 0.05 × armorEnchantLevel)",
    "sinDamage": "(sinLevel × 3 + 1) × sinResistance"
  }
}